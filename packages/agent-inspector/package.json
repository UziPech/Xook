{
  "name": "@xook/agent-inspector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Analizador e inspector en tiempo real de trazas JSONL del modo agente de XOOK.",
  "bin": {
    "xook-inspect": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/analyzer.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test src/*.test.ts",
    "inspect": "node src/cli.ts"
  }
}
